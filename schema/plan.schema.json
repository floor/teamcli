{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/floor/teamcli/blob/main/schema/plan.schema.json",
  "title": "team plan --json output",
  "$comment": "generated from src/output/schema.ts: the output contract in docs/reference/output.md is the source of truth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "format",
    "project",
    "session",
    "tasks"
  ],
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "team.plan"
        },
        "version": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "format": {
      "type": "integer",
      "const": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "session": {
      "type": "string",
      "minLength": 1
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "state",
          "owner",
          "id",
          "title"
        ],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "overdue"
            ]
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": [
              "string",
              "number"
            ]
          },
          "milestone": {
            "type": "string"
          },
          "deadline": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
