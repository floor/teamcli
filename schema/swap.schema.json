            "vendor": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "display": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "to": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cli",
            "vendor",
            "model",
            "version",
            "display",
            "launch"
          ],
          "properties": {
            "cli": {
              "type": "string",
              "minLength": 1
            },
            "vendor": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "display": {
              "type": "string",
              "minLength": 1
            },
            "launch": {
              "type": "string",
              "minLength": 1
            },
            "modelFrom": {
              "type": "string",
              "const": "launcher"
            },
            "effort": {
              "type": "string",
              "minLength": 1
            },
            "account": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "reason": {
          "type": "string",
          "enum": [
            "model-rule",
            "config",
            "owner"
          ]
        },
        "queuedAt": {
          "type": "string",
          "minLength": 1
        },
        "deadline": {
          "type": "string",
          "minLength": 1
        },
        "waitFor": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "type": "string"
        },
        "forced": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "by",
            "at"
          ],
          "properties": {
            "by": {
              "type": "string",
              "minLength": 1
            },
            "at": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "donor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "team",
        "root",
        "seat"
      ],
      "properties": {
        "team": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "seat": {
          "type": "string",
