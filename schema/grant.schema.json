{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/floor/teamcli/blob/main/schema/grant.schema.json",
  "title": "team grant --json output",
  "$comment": "generated from src/output/schema.ts: the output contract in docs/reference/output.md is the source of truth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "format",
    "dry_run",
    "status",
    "action_summary",
    "project",
    "session",
    "target"
  ],
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "team.grant"
        },
        "version": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "format": {
      "type": "integer",
      "const": 1
    },
    "dry_run": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "updated",
        "unchanged",
        "dry-run",
        "requested",
        "denied"
      ]
    },
    "action_summary": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": [
        "string",
        "null"
      ]
    },
    "session": {
      "type": [
        "string",
        "null"
      ]
    },
    "plan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "detail"
        ],
        "properties": {
          "step": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "seat": {
            "type": [
              "string",
              "null"
            ]
          },
          "prefix": {
            "type": "string",
            "enum": [
              "+",
              "!",
              "skip"
            ]
          }
        }
      }
    },
    "notice": {
      "type": [
        "string",
        "null"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "request": {
      "type": "object"
    },
    "summary": {
      "type": "object"
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "prompt": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "ignored": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
