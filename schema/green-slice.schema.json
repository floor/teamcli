{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/floor/teamcli/blob/main/schema/green-slice.schema.json",
  "title": "team queue ready|install --json output",
  "$comment": "generated from src/output/schema.ts: the output contract in docs/reference/output.md is the source of truth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "format",
    "project",
    "session",
    "action",
    "status",
    "event"
  ],
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "team.green-slice"
        },
        "version": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "format": {
      "type": "integer",
      "const": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "session": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": [
        "ready",
        "install"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "recorded",
        "held"
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "task",
        "commit",
        "version",
        "at"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "ready",
            "install"
          ]
        },
        "task": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 7,
          "maxLength": 40
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "seat": {
          "type": "string",
          "minLength": 1
        },
        "installedBy": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
