{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/floor/teamcli/blob/main/schema/status.schema.json",
  "title": "team status --json output",
  "$comment": "generated from src/output/schema.ts: the output contract in docs/reference/output.md is the source of truth",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "format",
        "project",
        "session",
        "rows",
        "notes",
        "differences",
        "summary",
        "notice"
      ],
      "properties": {
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "const": "team.status"
            },
            "version": {
              "type": "integer",
              "const": 1
            }
          }
        },
        "format": {
          "type": "integer",
          "const": 1
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "session": {
          "type": "string",
          "minLength": 1
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "state",
              "model",
              "pane"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "role": {
                "type": "string"
              },
              "nickname": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "cli": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "effort": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "last_active": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "pane": {
                "type": "string",
                "minLength": 1
              },
              "reach": {
                "type": "string",
                "enum": [
                  "socket",
                  "typed"
                ]
              },
              "launch_line": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "seat_state": {
                "type": "string"
              },
              "seat_state_source": {
                "type": "string"
              },
              "seat_presence": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state",
                  "source",
                  "event",
                  "since",
                  "live"
                ],
                "properties": {
                  "state": {
                    "type": "string",
                    "enum": [
                      "working",
                      "idle",
                      "waiting-for-a-person",
                      "gone"
                    ]
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "runtime-hook",
                      "runtime-event",
                      "daemon-launch"
                    ]
                  },
                  "event": {
                    "type": "string",
                    "enum": [
                      "turn-start",
                      "turn-end",
                      "human-wait",
                      "session-end"
                    ]
                  },
                  "since": {
                    "type": "string",
                    "minLength": 1
                  },
                  "live": {
                    "type": "boolean"
                  }
                }
              },
              "seat_presence_unreadable": {
                "type": "boolean",
                "const": true
              },
              "blind": {
                "type": "boolean",
                "const": true
              },
              "dev_mode": {
                "type": "boolean"
              },
              "start_cwd": {
                "type": "string"
              }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "differences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "what",
              "repair",
              "who"
            ],
            "properties": {
              "what": {
                "type": "string",
                "minLength": 1
              },
              "repair": {
                "type": "string",
                "minLength": 1
              },
              "who": {
                "type": "string",
                "enum": [
                  "the owner",
                  "the team's lead",
                  "a grant holder",
                  "any seat"
                ]
              }
            }
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "differences",
            "owner_differences"
          ],
          "properties": {
            "differences": {
              "type": "integer",
              "minimum": 0
            },
            "owner_differences": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "notice": {
          "type": [
            "string",
            "null"
          ]
        },
        "budgets": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "hold": {
          "type": "object"
        },
        "pause": {
          "type": "object"
        },
        "seat_pauses": {
          "type": "object"
        },
        "procs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "swaps": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "idle_work": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "at",
            "threshold_seconds",
            "takeable",
            "idle"
          ],
          "properties": {
            "format": {
              "type": "integer",
              "const": 1
            },
            "at": {
              "type": "string",
              "minLength": 1
            },
            "threshold_seconds": {
              "type": "integer",
              "minimum": 0
            },
            "threshold_unknown": {
              "type": "string",
              "minLength": 1
            },
            "takeable": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "refused": {
              "type": "string",
              "minLength": 1
            },
            "idle": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "seat"
                ],
                "properties": {
                  "seat": {
                    "type": "string",
                    "minLength": 1
                  },
                  "since": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "green_slices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task",
              "seat",
              "commit",
              "version",
              "readyAt"
            ],
            "properties": {
              "task": {
                "type": "string",
                "minLength": 1
              },
              "seat": {
                "type": "string",
                "minLength": 1
              },
              "commit": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "readyAt": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "green_notice": {
          "type": "string"
        },
        "daemon": {
          "type": "object"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "format",
        "project",
        "teams"
      ],
      "properties": {
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "const": "team.status.project"
            },
            "version": {
              "type": "integer",
              "const": 1
            }
          }
        },
        "format": {
          "type": "integer",
          "const": 1
        },
        "project": {
          "type": "object"
        },
        "teams": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "session",
              "lifecycle",
              "seats"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "session": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "lifecycle": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "seats": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
