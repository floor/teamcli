{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/floor/teamcli/blob/main/schema/projects.schema.json",
  "title": "team projects --json output",
  "$comment": "generated from src/output/schema.ts: the output contract in docs/reference/output.md is the source of truth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "format",
    "projects"
  ],
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "team.projects"
        },
        "version": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "format": {
      "type": "integer",
      "const": 1
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "entity",
          "lead",
          "teams",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "entity": {
            "type": [
              "string",
              "null"
            ]
          },
          "lead": {
            "type": [
              "string",
              "null"
            ]
          },
          "teams": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deliveryOrder": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "socket",
                "native",
                "mcp-inbox",
                "typed",
                "drop",
                "headless-resume"
              ]
            }
          },
          "senderName": {
            "type": "string",
            "enum": [
              "auto",
              "nickname",
              "seat",
              "seat@team"
            ]
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "registered_by",
              "registered_at",
              "updated_at"
            ],
            "properties": {
              "registered_by": {
                "type": "string"
              },
              "registered_at": {
                "type": "string"
              },
              "updated_at": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
