{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/floor/teamcli/blob/main/schema/release.schema.json",
  "title": "team release --json output",
  "$comment": "generated from src/output/schema.ts: the output contract in docs/reference/output.md is the source of truth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "format",
    "package",
    "version",
    "checks",
    "summary"
  ],
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "team.release"
        },
        "version": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "format": {
      "type": "integer",
      "const": 1
    },
    "package": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "npm",
        "tag",
        "github",
        "changelog"
      ],
      "properties": {
        "npm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "detail"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pass",
                "missing",
                "unknown"
              ]
            },
            "detail": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "tag": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "detail"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pass",
                "missing",
                "unknown"
              ]
            },
            "detail": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "github": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "detail"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pass",
                "missing",
                "unknown"
              ]
            },
            "detail": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "changelog": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "detail"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pass",
                "missing",
                "unknown"
              ]
            },
            "detail": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "linear": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "detail"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pass",
                "missing",
                "unknown"
              ]
            },
            "detail": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "activity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "detail"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pass",
                "missing",
                "unknown"
              ]
            },
            "detail": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "warning": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checks",
        "missing",
        "unknown"
      ],
      "properties": {
        "checks": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
