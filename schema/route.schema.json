{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/floor/teamcli/blob/main/schema/route.schema.json",
  "title": "team route --json output",
  "$comment": "generated from src/output/schema.ts: the output contract in docs/reference/output.md is the source of truth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "format",
    "dry_run",
    "status",
    "action_summary",
    "project",
    "session",
    "seat",
    "address"
  ],
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "team.route"
        },
        "version": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "format": {
      "type": "integer",
      "const": 1
    },
    "dry_run": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "routed",
        "dry-run"
      ]
    },
    "action_summary": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": [
        "string",
        "null"
      ]
    },
    "session": {
      "type": [
        "string",
        "null"
      ]
    },
    "plan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "detail"
        ],
        "properties": {
          "step": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "seat": {
            "type": [
              "string",
              "null"
            ]
          },
          "prefix": {
            "type": "string",
            "enum": [
              "+",
              "!",
              "skip"
            ]
          }
        }
      }
    },
    "seat": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "recipient_session": {
      "type": "string",
      "minLength": 1
    },
    "cli": {
      "type": "string",
      "minLength": 1
    },
    "pane": {
      "type": "string",
      "minLength": 1
    },
    "address": {
      "type": [
        "string",
        "null"
      ]
    },
    "socket_state": {
      "type": "string",
      "enum": [
        "live",
        "stale",
        "pane",
        "none",
        "unread"
      ]
    },
    "native": {
      "type": "boolean"
    },
    "rule": {
      "type": "string",
      "minLength": 1
    }
  }
}
