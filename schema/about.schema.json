{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/floor/teamcli/blob/main/schema/about.schema.json",
  "title": "team --about --json output",
  "$comment": "generated from src/output/schema.ts: the output contract in docs/reference/output.md is the source of truth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "format",
    "version",
    "description",
    "licence",
    "docs",
    "must_not_pretend"
  ],
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "team.about"
        },
        "version": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "format": {
      "type": "integer",
      "const": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "licence": {
      "type": "string",
      "minLength": 1
    },
    "docs": {
      "type": "string",
      "minLength": 1
    },
    "must_not_pretend": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "ref"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
