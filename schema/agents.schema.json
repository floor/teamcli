{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/floor/teamcli/blob/main/schema/agents.schema.json",
  "title": "team agents prune --json output",
  "$comment": "generated from src/output/schema.ts: the output contract in docs/reference/output.md is the source of truth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "format",
    "apply",
    "records",
    "counts"
  ],
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "team.agents"
        },
        "version": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "format": {
      "type": "integer",
      "const": 1
    },
    "apply": {
      "type": "boolean"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "team",
          "project",
          "seat",
          "session",
          "lifecycle",
          "state",
          "action",
          "orphaned_at",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "team": {
            "type": "string",
            "minLength": 1
          },
          "project": {
            "type": [
              "string",
              "null"
            ]
          },
          "seat": {
            "type": "string",
            "minLength": 1
          },
          "session": {
            "type": "string",
            "minLength": 1
          },
          "lifecycle": {
            "type": "string",
            "enum": [
              "registered",
              "running",
              "stopped",
              "retired"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "orphaned",
              "superseded",
              "declared",
              "unverified",
              "unregistered"
            ]
          },
          "action": {
            "type": "string",
            "enum": [
              "retire",
              "none"
            ]
          },
          "orphaned_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "listed",
        "orphaned",
        "superseded",
        "declared",
        "unverified",
        "unregistered",
        "to_retire",
        "retired",
        "unchanged",
        "failed"
      ],
      "properties": {
        "listed": {
          "type": "integer",
          "minimum": 0
        },
        "orphaned": {
          "type": "integer",
          "minimum": 0
        },
        "superseded": {
          "type": "integer",
          "minimum": 0
        },
        "declared": {
          "type": "integer",
          "minimum": 0
        },
        "unverified": {
          "type": "integer",
          "minimum": 0
        },
        "unregistered": {
          "type": "integer",
          "minimum": 0
        },
        "to_retire": {
          "type": "integer",
          "minimum": 0
        },
        "retired": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
