{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/floor/teamcli/blob/main/schema/up.schema.json",
  "title": "team up --json output",
  "$comment": "generated from src/output/schema.ts: the output contract in docs/reference/output.md is the source of truth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "format",
    "dry_run",
    "status",
    "action_summary",
    "seats"
  ],
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "team.up"
        },
        "version": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "format": {
      "type": "integer",
      "const": 1
    },
    "dry_run": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "dry-run"
      ]
    },
    "action_summary": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": [
        "string",
        "null"
      ]
    },
    "session": {
      "type": [
        "string",
        "null"
      ]
    },
    "plan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "detail"
        ],
        "properties": {
          "step": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "seat": {
            "type": [
              "string",
              "null"
            ]
          },
          "prefix": {
            "type": "string",
            "enum": [
              "+",
              "!",
              "skip"
            ]
          }
        }
      }
    },
    "notice": {
      "type": [
        "string",
        "null"
      ]
    },
    "seats": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "no_launch": {
      "type": "boolean",
      "const": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "restore_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repaired",
        "skipped_working",
        "refused",
        "repaired_seats",
        "skipped_working_seats",
        "refused_seats",
        "line"
      ],
      "properties": {
        "repaired": {
          "type": "integer",
          "minimum": 0
        },
        "skipped_working": {
          "type": "integer",
          "minimum": 0
        },
        "refused": {
          "type": "integer",
          "minimum": 0
        },
        "repaired_seats": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "skipped_working_seats": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "refused_seats": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seat",
              "reason"
            ],
            "properties": {
              "seat": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "line": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
