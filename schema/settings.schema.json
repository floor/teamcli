{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/floor/teamcli/blob/main/schema/settings.schema.json",
  "title": "team settings <seat> --json output",
  "$comment": "generated from src/output/schema.ts: the output contract in docs/reference/output.md is the source of truth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "format",
    "project",
    "seat",
    "settings"
  ],
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "team.settings"
        },
        "version": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "format": {
      "type": "integer",
      "const": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "seat": {
      "type": "string",
      "minLength": 1
    },
    "settings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "value",
          "source",
          "applies"
        ],
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "model",
              "effort",
              "nickname",
              "delivery_order",
              "human"
            ]
          },
          "value": {
            "type": [
              "string",
              "boolean",
              "array",
              "null"
            ],
            "items": {
              "type": "string",
              "enum": [
                "socket",
                "native",
                "mcp-inbox",
                "typed",
                "drop"
              ]
            }
          },
          "source": {
            "type": "string",
            "enum": [
              "entity record",
              "project record",
              "team record",
              "seat record",
              "team file",
              "team default",
              "default",
              "none"
            ]
          },
          "applies": {
            "type": "string",
            "enum": [
              "restart-resume",
              "at-once"
            ]
          },
          "source_file": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
