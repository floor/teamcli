{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/floor/teamcli/blob/main/schema/send.schema.json",
  "title": "team send --json output",
  "$comment": "generated from src/output/schema.ts: the output contract in docs/reference/output.md is the source of truth",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "format",
        "dry_run",
        "status",
        "action_summary",
        "project",
        "session",
        "seat",
        "ids"
      ],
      "properties": {
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "const": "team.send"
            },
            "version": {
              "type": "integer",
              "const": 1
            }
          }
        },
        "format": {
          "type": "integer",
          "const": 1
        },
        "dry_run": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "delivered",
            "delivered (read)",
            "sent (unconfirmed)",
            "sent (channel)",
            "queued (receiver busy)",
            "answered",
            "recorded",
            "native",
            "dry-run"
          ]
        },
        "action_summary": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "session": {
          "type": [
            "string",
            "null"
          ]
        },
        "seat": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "socket",
            "typed",
            "drop",
            "mcp-inbox",
            "native",
            "headless-resume",
            "channel",
            null
          ]
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "confirm": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "ids": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sent",
            "reply"
          ],
          "properties": {
            "sent": {
              "type": [
                "string",
                "null"
              ]
            },
            "reply": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "thread": {
          "type": [
            "string",
            "null"
          ]
        },
        "reply": {
          "type": "string"
        },
        "address": {
          "type": [
            "string",
            "null"
          ]
        },
        "plan": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step",
              "detail"
            ],
            "properties": {
              "step": {
                "type": "string",
                "minLength": 1
              },
              "detail": {
                "type": "string",
                "minLength": 1
              },
              "seat": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "prefix": {
                "type": "string",
                "enum": [
                  "+",
                  "!",
                  "skip"
                ]
              }
            }
          }
        },
        "delivery": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "leg",
              "state"
            ],
            "properties": {
              "leg": {
                "type": "string",
                "enum": [
                  "socket",
                  "native",
                  "mcp-inbox",
                  "typed",
                  "drop",
                  "headless-resume"
                ]
              },
              "state": {
                "type": "string",
                "enum": [
                  "attempted",
                  "queued",
                  "skipped",
                  "refused",
                  "not-reached",
                  "candidate"
                ]
              },
              "eligible": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "format",
        "project",
        "session",
        "seats",
        "summary"
      ],
      "properties": {
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "const": "team.send.list"
            },
            "version": {
              "type": "integer",
              "const": 1
            }
          }
        },
        "format": {
          "type": "integer",
          "const": 1
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "session": {
          "type": "string",
          "minLength": 1
        },
        "seats": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "nickname",
              "cli",
              "role",
              "project",
              "reach",
              "stopped"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "nickname": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "cli": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string"
              },
              "project": {
                "type": "string",
                "minLength": 1
              },
              "reach": {
                "type": "string",
                "enum": [
                  "socket",
                  "typed"
                ]
              },
              "stopped": {
                "type": "boolean"
              }
            }
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  ]
}
