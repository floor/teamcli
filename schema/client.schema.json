{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/floor/teamcli/blob/main/schema/client.schema.json",
  "title": "team client keygen --json output",
  "$comment": "generated from src/output/schema.ts: the output contract in docs/reference/output.md is the source of truth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "format",
    "status",
    "key_path",
    "public_key_path",
    "key_dir",
    "public_key",
    "key_id",
    "key_isolation"
  ],
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "team.client.keygen"
        },
        "version": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "format": {
      "type": "integer",
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "created"
      ]
    },
    "key_path": {
      "type": "string",
      "minLength": 1
    },
    "public_key_path": {
      "type": "string",
      "minLength": 1
    },
    "key_dir": {
      "type": "string",
      "minLength": 1
    },
    "public_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "key_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "key_isolation": {
      "type": "string",
      "minLength": 1
    }
  }
}
