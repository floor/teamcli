{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/floor/teamcli/blob/main/schema/error.schema.json",
  "title": "A team command error envelope (--json)",
  "$comment": "generated from src/output/schema.ts: the output contract in docs/reference/output.md is the source of truth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "error"
  ],
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "team.error"
        },
        "version": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "message",
        "repair"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "repair": {
          "type": [
            "string",
            "null"
          ]
        },
        "rule": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "notice": {
      "type": [
        "string",
        "null"
      ]
    },
    "key_isolation": {
      "type": "string",
      "minLength": 1
    },
    "delivery": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "leg",
          "state"
        ],
        "properties": {
          "leg": {
            "type": "string",
            "enum": [
              "socket",
              "native",
              "mcp-inbox",
              "typed",
              "drop",
              "headless-resume"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "attempted",
              "queued",
              "skipped",
              "refused",
              "not-reached",
              "candidate"
            ]
          },
          "eligible": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
