{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/floor/teamcli/blob/main/schema/feed.schema.json",
  "title": "team feed --json output",
  "$comment": "generated from src/output/schema.ts: the output contract in docs/reference/output.md is the source of truth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "format",
    "project",
    "session",
    "events"
  ],
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "team.feed"
        },
        "version": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "format": {
      "type": "integer",
      "const": 1
    },
    "project": {
      "type": [
        "string",
        "null"
      ]
    },
    "session": {
      "type": [
        "string",
        "null"
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ts",
              "from",
              "to",
              "body",
              "id",
              "outcome",
              "status"
            ],
            "properties": {
              "ts": {
                "type": "string"
              },
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "outcome": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "thread": {
                "type": "string"
              },
              "in_reply_to": {
                "type": "string"
              },
              "from_team": {
                "type": "string"
              },
              "ms": {
                "type": "number"
              },
              "via": {
                "type": "string"
              },
              "failed": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "note": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "ts",
              "session",
              "seat",
              "state",
              "event",
              "source",
              "binding",
              "seq",
              "presence_seq",
              "event_id",
              "observed_at",
              "id"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "const": "presence.changed"
              },
              "ts": {
                "type": "string"
              },
              "session": {
                "type": "string"
              },
              "seat": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "enum": [
                  "working",
                  "idle",
                  "waiting-for-a-person",
                  "gone"
                ]
              },
              "event": {
                "type": "string",
                "enum": [
                  "turn-start",
                  "turn-end",
                  "human-wait",
                  "session-end"
                ]
              },
              "source": {
                "type": "string",
                "enum": [
                  "runtime-hook",
                  "runtime-event",
                  "daemon-launch"
                ]
              },
              "binding": {
                "type": "string"
              },
              "seq": {
                "type": "integer"
              },
              "presence_seq": {
                "type": "integer"
              },
              "event_id": {
                "type": "string"
              },
              "observed_at": {
                "type": "string"
              },
              "id": {
                "type": "string"
              }
            }
          }
        ]
      }
    }
  }
}
