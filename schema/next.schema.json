{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/floor/teamcli/blob/main/schema/next.schema.json",
  "title": "team next --json output",
  "$comment": "generated from src/output/schema.ts: the output contract in docs/reference/output.md is the source of truth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "format",
    "dry_run",
    "status",
    "action_summary",
    "project",
    "session",
    "action",
    "task"
  ],
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "team.next"
        },
        "version": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "format": {
      "type": "integer",
      "const": 1
    },
    "dry_run": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "claimed",
        "released",
        "none"
      ]
    },
    "action_summary": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "session": {
      "type": "string",
      "minLength": 1
    },
    "plan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "detail"
        ],
        "properties": {
          "step": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "seat": {
            "type": [
              "string",
              "null"
            ]
          },
          "prefix": {
            "type": "string",
            "enum": [
              "+",
              "!",
              "skip"
            ]
          }
        }
      }
    },
    "notice": {
      "type": [
        "string",
        "null"
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "claim",
        "release",
        "none"
      ]
    },
    "task": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
