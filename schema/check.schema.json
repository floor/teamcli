{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/floor/teamcli/blob/main/schema/check.schema.json",
  "title": "team check --json output",
  "$comment": "generated from src/output/schema.ts: the output contract in docs/reference/output.md is the source of truth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "format",
    "project",
    "session",
    "key_isolation",
    "warnings",
    "repaired",
    "notes",
    "differences",
    "summary"
  ],
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "team.check"
        },
        "version": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "format": {
      "type": "integer",
      "const": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "session": {
      "type": "string",
      "minLength": 1
    },
    "key_isolation": {
      "type": "string",
      "minLength": 1
    },
    "notice": {
      "type": [
        "string",
        "null"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repaired": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "differences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "what",
          "repair",
          "who"
        ],
        "properties": {
          "what": {
            "type": "string",
            "minLength": 1
          },
          "repair": {
            "type": "string",
            "minLength": 1
          },
          "who": {
            "type": "string",
            "enum": [
              "the owner",
              "the team's lead",
              "a grant holder",
              "any seat"
            ]
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "differences",
        "owner_differences"
      ],
      "properties": {
        "differences": {
          "type": "integer",
          "minimum": 0
        },
        "owner_differences": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "idle_work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "at",
        "threshold_seconds",
        "takeable",
        "idle"
      ],
      "properties": {
        "format": {
          "type": "integer",
          "const": 1
        },
        "at": {
          "type": "string",
          "minLength": 1
        },
        "threshold_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "threshold_unknown": {
          "type": "string",
          "minLength": 1
        },
        "takeable": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "refused": {
          "type": "string",
          "minLength": 1
        },
        "idle": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seat"
            ],
            "properties": {
              "seat": {
                "type": "string",
                "minLength": 1
              },
              "since": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "green_slices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task",
          "seat",
          "commit",
          "version",
          "readyAt"
        ],
        "properties": {
          "task": {
            "type": "string",
            "minLength": 1
          },
          "seat": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "readyAt": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "green_notice": {
      "type": "string"
    },
    "hint": {
      "type": "string",
      "minLength": 1
    }
  }
}
