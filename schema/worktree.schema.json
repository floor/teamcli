{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/floor/teamcli/blob/main/schema/worktree.schema.json",
  "title": "team worktree --json output",
  "$comment": "generated from src/output/schema.ts: the output contract in docs/reference/output.md is the source of truth",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "format",
        "dry_run",
        "status",
        "action_summary",
        "project",
        "session",
        "action",
        "task"
      ],
      "properties": {
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "const": "team.worktree"
            },
            "version": {
              "type": "integer",
              "const": 1
            }
          }
        },
        "format": {
          "type": "integer",
          "const": 1
        },
        "dry_run": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "created",
            "removed",
            "record-gone"
          ]
        },
        "action_summary": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "session": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "enum": [
            "new",
            "remove"
          ]
        },
        "task": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "notice": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "format",
        "project",
        "session",
        "notice",
        "worktrees",
        "notes",
        "summary"
      ],
      "properties": {
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "const": "team.worktree"
            },
            "version": {
              "type": "integer",
              "const": 1
            }
          }
        },
        "format": {
          "type": "integer",
          "const": 1
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "session": {
          "type": "string",
          "minLength": 1
        },
        "notice": {
          "type": [
            "string",
            "null"
          ]
        },
        "worktrees": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task",
              "branch",
              "path",
              "session",
              "seat",
              "exists"
            ],
            "properties": {
              "task": {
                "type": "string",
                "minLength": 1
              },
              "branch": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "session": {
                "type": "string",
                "minLength": 1
              },
              "seat": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "exists": {
                "type": "boolean"
              }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "worktrees"
          ],
          "properties": {
            "worktrees": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  ]
}
