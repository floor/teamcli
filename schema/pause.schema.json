{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/floor/teamcli/blob/main/schema/pause.schema.json",
  "title": "team pause --json output",
  "$comment": "generated from src/output/schema.ts: the output contract in docs/reference/output.md is the source of truth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "format",
    "dry_run",
    "status",
    "action_summary",
    "project",
    "session",
    "target",
    "value",
    "pause"
  ],
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "team.pause"
        },
        "version": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "format": {
      "type": "integer",
      "const": 1
    },
    "dry_run": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "paused"
      ]
    },
    "action_summary": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": [
        "string",
        "null"
      ]
    },
    "session": {
      "type": [
        "string",
        "null"
      ]
    },
    "plan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "detail"
        ],
        "properties": {
          "step": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "seat": {
            "type": [
              "string",
              "null"
            ]
          },
          "prefix": {
            "type": "string",
            "enum": [
              "+",
              "!",
              "skip"
            ]
          }
        }
      }
    },
    "notice": {
      "type": [
        "string",
        "null"
      ]
    },
    "target": {
      "type": "string",
      "enum": [
        "team",
        "seat"
      ]
    },
    "value": {
      "type": [
        "string",
        "null"
      ]
    },
    "pause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "at",
        "stops"
      ],
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "stops": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seat"
            ],
            "properties": {
              "seat": {
                "type": "string",
                "minLength": 1
              },
              "stage": {
                "type": "string",
                "enum": [
                  "launched",
                  "named",
                  "ready"
                ]
              },
              "branch": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "last_active": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
