{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/floor/teamcli/blob/main/schema/trace.schema.json",
  "title": "team trace --json output",
  "$comment": "generated from src/output/schema.ts: the output contract in docs/reference/output.md is the source of truth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "format",
    "project",
    "session",
    "id",
    "steps",
    "summary",
    "unverified"
  ],
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "team.trace"
        },
        "version": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "format": {
      "type": "integer",
      "const": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "session": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "seq",
          "ts",
          "kind",
          "record_id",
          "delta_ms"
        ],
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 1
          },
          "ts": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "seat": {
            "type": "string"
          },
          "thread": {
            "type": "string"
          },
          "via": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "ms": {
            "type": "number",
            "minimum": 0
          },
          "reason": {
            "type": "string"
          },
          "delta_ms": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "unverified": {
      "type": "integer",
      "minimum": 0
    }
  }
}
