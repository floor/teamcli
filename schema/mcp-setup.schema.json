{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/floor/teamcli/blob/main/schema/mcp-setup.schema.json",
  "title": "team mcp setup --json output",
  "$comment": "generated from src/output/schema.ts: the output contract in docs/reference/output.md is the source of truth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "format",
    "seat",
    "session",
    "cwd",
    "dry_run",
    "status",
    "changes"
  ],
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "team.mcp-setup"
        },
        "version": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "format": {
      "type": "integer",
      "const": 1
    },
    "seat": {
      "type": "string",
      "minLength": 1
    },
    "session": {
      "type": "string",
      "minLength": 1
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "dry_run": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "setup",
        "off",
        "unchanged"
      ]
    },
    "changes": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "action"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "project-config",
              "launch",
              "placement"
            ]
          },
          "action": {
            "type": "string",
            "enum": [
              "prepare",
              "restore",
              "enable",
              "keep",
              "record"
            ]
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "path": {
            "type": "string"
          },
          "pane": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
