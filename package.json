{
  "name": "team",
  "version": "0.5.4-rc.5",
  "description": "Ship with a team that never sleeps. Specialized agents, from any lab.",
  "keywords": [
    "ai-agents",
    "agents",
    "multi-agent",
    "orchestration",
    "herdr",
    "cli"
  ],
  "homepage": "https://github.com/floor/teamcli#readme",
  "bugs": {
    "url": "https://github.com/floor/teamcli/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "team": "dist/cli.js"
  },
  "exports": {
    ".": {
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "schema",
    "packages/relay/index.js",
    "packages/relay/index.d.ts",
    "packages/relay/host",
    "packages/relay/package.json",
    "packages/relay/README.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/floor/teamcli.git"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "e2e": "bun scripts/e2e.ts",
    "build": "bun scripts/build.ts",
    "pack": "bun scripts/pack.ts",
    "conformance": "bun scripts/conformance.ts --impl \"node dist/cli.js conformance-adapter\"",
    "coverage": "bun scripts/coverage.ts",
    "coverage:check": "bun scripts/coverage.ts --check",
    "schema:check": "bun scripts/schema.ts",
    "contract": "bun scripts/contract.ts",
    "contract:check": "bun scripts/contract.ts --check",
    "exit-codes:check": "bun scripts/exit-codes.ts --check",
    "readme:check": "bun scripts/check-readmes.ts",
    "brief": "bun scripts/brief.ts",
    "brief:check": "bun scripts/brief.ts --check",
    "public-names:check": "bun scripts/check-public-names.ts",
    "ci": "bun run typecheck && bun test && bun run build && node dist/cli.js --version && bun run conformance && bun run schema:check && bun run contract:check && bun run coverage:check && bun run brief:check && bun run public-names:check && bun run exit-codes:check && bun run readme:check"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
