{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/floor/teamcli/blob/main/src/profiles/profile.schema.json",
  "title": "A CLI profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "cli", "screen"],
  "properties": {
    "format": { "const": 1 },
    "cli": { "type": "string", "minLength": 1 },
    "binary": { "type": "string", "minLength": 1 },
    "process_names": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "tested": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 }
      }
    },
    "unattended": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "rules": {
      "oneOf": [
        { "const": "first-message" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["option"],
          "properties": { "option": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "login": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "hint"],
      "properties": {
        "check": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "hint": { "type": "string", "minLength": 1 }
      }
    },
    "exit": { "type": "string", "minLength": 1 },
    "exit_clear": {
      "type": "string",
      "enum": ["ctrl+c", "ctrl+u", "escape", "backspace"],
      "description": "optional: the one key that empties the CLI's input box, sent only to clear an exit text that did not read back as typed; absent, the text is left for the owner"
    },
    "exit_confirm": {
      "type": "string",
      "enum": ["enter"],
      "description": "optional: the one key that confirms the CLI's own exit question, sent by a stop on a screen the profile reads as an exit question; absent, a seat that asks the question cannot be stopped by asking"
    },
    "lobby_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "optional: the exact relative paths of regular files a capture showed this CLI writing in its working folder, which a shared lobby may therefore hold beside the seats; absent, no path is tolerated for this CLI"
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idle", "exit"],
      "properties": {
        "idle": { "type": "string", "pattern": "^[0-9]+s$" },
        "exit": { "type": "string", "pattern": "^[0-9]+s$" }
      }
    },
    "models": { "$ref": "#/$defs/models" },
    "status_model": { "type": "array", "items": { "$ref": "#/$defs/statusModelRule" }, "minItems": 1, "description": "optional: absent, the CLI's screen doesn't show its model" },
    "last_used_model": { "type": "boolean", "description": "optional: the CLI starts on its last-used model when a launch names none" },
    "model_form": { "type": "string", "minLength": 1, "description": "optional: how a launch tells this CLI its model, recorded only where a run has shown the form; absent, a mismatch line says nothing more" },
    "quota": { "type": "array", "items": { "$ref": "#/$defs/quota" }, "minItems": 1 },
    "trust_answer": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/trustAnswer" } },
    "screen": { "$ref": "#/$defs/screen" },
    "screen_module": { "$ref": "#/$defs/screenModule" }
  },
  "anyOf": [
    { "required": ["screen_module"] },
    {
      "properties": {
        "screen": {
          "anyOf": [
            { "required": ["composer"] },
            { "required": ["screen_module"] }
          ]
        }
      }
    }
  ],
  "$defs": {
    "trustAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "label", "action", "capture", "extract"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "mark": { "type": "string", "minLength": 1 },
        "footer": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "pattern": "^[0-9a-fA-F]{2}$" },
        "capture": { "type": "string", "minLength": 1, "description": "The registered capture this record's predicate, label and extractor were taken from: the manifest's whole path, not a basename." },
        "lobby_evidence": { "type": "string", "minLength": 1, "description": "Codex only: a registered capture of the folder-only layout taken in the real lobby. Other CLIs must not claim it." },
        "extract": { "$ref": "#/$defs/trustExtract" }
      }
    },
    "trustExtract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["after"],
      "properties": {
        "after": { "type": "string", "minLength": 1 },
        "before": { "type": "string", "minLength": 1 },
        "until_blank": { "type": "boolean" },
        "join": { "type": "boolean", "description": "Join the rows after the anchor only when they prove one wrapped path: the first fills the wrap column, each later row starts at the indent. Off, the extractor refuses a run with more than one row." },
        "indent": { "type": "integer", "minimum": 0, "description": "With join: the continuation column the capture draws." },
        "wrap": { "type": "integer", "minimum": 0, "description": "With join: the column the capture's first wrapped row fills exactly." },
        "box": { "type": "boolean" },
        "refuse_line": { "type": "string", "minLength": 1 }
      },
      "anyOf": [{ "required": ["before"] }, { "required": ["until_blank"] }],
      "allOf": [
        { "if": { "properties": { "join": { "const": true } }, "required": ["join"] }, "then": { "required": ["indent", "wrap"] } }
      ]
    },
    "screenModule": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!(?:\\.[\\/\\\\])*(?:node_modules|test|src|dist|scripts|examples|worktrees|\\.github)(?:[\\/\\\\]|$))(?!.*(?:^|[\\/\\\\])\\.\\.(?:[\\/\\\\]|$))(?!.*%2[eE]%2[eE])[^/~\\\\:][^:]*\\.(?:ts|js|cjs|mjs)$"
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account", "match", "window"],
      "oneOf": [{ "required": ["left"] }, { "required": ["used"] }],
      "properties": {
        "account": { "type": "string", "minLength": 1 },
        "match": { "type": "string", "minLength": 1, "maxLength": 200 },
        "left": { "type": "string", "minLength": 1 },
        "used": { "type": "string", "minLength": 1 },
        "resets": { "type": "string", "minLength": 1 },
        "window": { "enum": ["session", "daily", "weekly"] }
      }
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chrome": { "type": "array", "items": { "type": "string", "maxLength": 200 } },
        "unknown": { "$ref": "#/$defs/stage" },
        "trust": { "$ref": "#/$defs/stage" },
        "permission": { "$ref": "#/$defs/stage" },
        "exit_question": { "$ref": "#/$defs/stage" },
        "question": { "$ref": "#/$defs/stage" },
        "vendor_notice": { "$ref": "#/$defs/vendorNotice" },
        "provider_error": { "$ref": "#/$defs/stage" },
        "rate_limit": { "$ref": "#/$defs/stage" },
        "working": { "$ref": "#/$defs/stage" },
        "composer": { "$ref": "#/$defs/composer" },
        "screen_module": { "$ref": "#/$defs/screenModule" }
      }
    },
    "stage": {
      "oneOf": [
        { "type": "array", "items": { "$ref": "#/$defs/rule" }, "minItems": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["rules"],
          "properties": {
            "ignore_case": {
              "type": "boolean",
              "description": "Ignore ASCII case only: each letter matches its other case; no other character folds (a long s or a Kelvin sign reads as itself). The flag reaches every rule of the stage, the exceptions written beside a match included."
            },
            "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" }, "minItems": 1 }
          }
        }
      ]
    },
    "vendorNotice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules", "tested"],
      "description": "A vendor's own notice — an update screen, for one. Never answered, and never a reading without a record: the `tested` range is the version the capture was taken on, and the loader requires it. The list form is refused.",
      "properties": {
        "ignore_case": {
          "type": "boolean",
          "description": "Ignore ASCII case only: each letter matches its other case; no other character folds. The flag reaches every rule of the stage, the exceptions written beside a match included."
        },
        "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" }, "minItems": 1 },
        "tested": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": { "type": "string" },
            "to": { "type": "string" }
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["any"] },
        { "required": ["all"] },
        { "required": ["footer"] },
        { "required": ["below_last_rule"] },
        { "required": ["none_after"] },
        { "required": ["only_after"] },
        { "required": ["block"] }
      ],
      "if": { "required": ["block"] },
      "then": {
        "additionalProperties": false,
        "properties": { "block": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/blockStep" } } }
      },
      "properties": {
        "any": { "$ref": "#/$defs/patterns" },
        "all": { "$ref": "#/$defs/patterns" },
        "footer": { "type": "string" },
        "on_footer": { "type": "boolean" },
        "below_last_rule": { "type": "string", "maxLength": 200 },
        "without_rule": { "type": "boolean" },
        "none_after": {
          "type": "object",
          "additionalProperties": false,
          "required": ["anchor", "patterns"],
          "properties": {
            "anchor": { "$ref": "#/$defs/pattern" },
            "patterns": { "$ref": "#/$defs/patterns" }
          }
        },
        "only_after": {
          "type": "object",
          "additionalProperties": false,
          "required": ["anchor", "patterns"],
          "properties": {
            "anchor": { "$ref": "#/$defs/pattern" },
            "patterns": { "$ref": "#/$defs/patterns" }
          }
        },
        "block": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/blockStep" } }
      }
    },
    "blockStep": {
      "oneOf": [
        { "type": "string", "maxLength": 200 },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "list": { "const": true },
            "one_of": { "type": "array", "minItems": 1, "items": { "type": "array", "items": { "$ref": "#/$defs/blockStep" } } }
          },
          "oneOf": [{ "required": ["list"] }, { "required": ["one_of"] }]
        }
      ]
    },
    "patterns": { "type": "array", "items": { "$ref": "#/$defs/pattern" }, "minItems": 1 },
    "pattern": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 200 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["match"],
          "properties": {
            "match": { "type": "string", "minLength": 1, "maxLength": 200 },
            "ignore_case": {
              "type": "boolean",
              "description": "Ignore ASCII case only: each letter matches its other case; no other character folds (a long s or a Kelvin sign reads as itself). The flag is the entry's, so it reaches the except list beside the match."
            },
            "except": { "type": "array", "items": { "type": "string", "maxLength": 200 }, "minItems": 1 }
          }
        }
      ]
    },
    "placeholders": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "oneOf": [
          { "required": ["equals"], "not": { "required": ["prefix"] } },
          { "required": ["prefix"], "not": { "required": ["equals"] } }
        ],
        "properties": {
          "equals": { "type": "string" },
          "prefix": { "type": "string", "minLength": 1 }
        }
      }
    },
    "patternString": { "type": "string", "minLength": 1, "maxLength": 200 },
    "modelRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match", "model", "version"],
      "properties": {
        "match": { "$ref": "#/$defs/patternString" },
        "ignore_case": {
          "type": "boolean",
          "description": "Ignore ASCII case only: each letter matches its other case; no other character folds (a long s or a Kelvin sign reads as itself)."
        },
        "model": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "flag": { "type": "string", "minLength": 1, "description": "The model id to suggest for this model and version. \"{version}\" is the seat's version." }
      }
    },
    "statusModelRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match", "model", "version"],
      "properties": {
        "match": { "$ref": "#/$defs/patternString" },
        "ignore_case": {
          "type": "boolean",
          "description": "Ignore ASCII case only: each letter matches its other case; no other character folds (a long s or a Kelvin sign reads as itself)."
        },
        "model": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "flag": { "type": "string", "minLength": 1, "description": "The model id to suggest for this model and version. \"{version}\" is the seat's version." },
        "yields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "description": "The exact model names this rule's templates spell, as the reader reads them back — a closed list, never a pattern, each name once. Absent or empty: the rule yields no model (a template that cannot fill, like an id a launch line shows but the screen never does)."
        },
        "version_like": {
          "type": "string",
          "minLength": 1,
          "description": "The version shapes this rule can spell its models with: a regular expression source anchored at both ends (\"^\" and \"$\"), tested against the whole version. Absent: the rule spells no version. A source not anchored at both ends is refused as the profile loads."
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option", "ids"],
      "properties": {
        "option": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "absent": { "const": "last-used", "description": "What a launch that names no model does. last-used: the CLI starts on whatever model it used last." },
        "ids": { "type": "array", "items": { "$ref": "#/$defs/modelRule" }, "minItems": 1 }
      }
    },
    "composer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "prompt", "placeholders"],
      "properties": {
        "mode": { "enum": ["box-to-rule", "status-last", "status-then-one", "two-rules-footer-below"] },
        "prompt": { "$ref": "#/$defs/patternString" },
        "rule": { "$ref": "#/$defs/patternString" },
        "status_line": {
          "description": "The status line's patterns: one string, or a list where one pattern per family would not fit the dialect's length cap. A line is a candidate when it matches any entry.",
          "oneOf": [
            { "$ref": "#/$defs/patternString" },
            { "type": "array", "items": { "$ref": "#/$defs/patternString" }, "minItems": 1 }
          ]
        },
        "status_below": {
          "description": "Where the status row must sit, declared only for a CLI whose captures show the pane drawing a workspace line under it. The line directly under the row must match `line` and be the pane's last non-blank one, and the `  →` input row must sit above the row within the distance the captures show; a grammar line anywhere else is ordinary text. A row matching `except` keeps its grammar-only reading, wherever it is — the reading it had before this field existed. A bare string is `line` with no exemption.",
          "oneOf": [
            { "$ref": "#/$defs/patternString" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["line"],
              "properties": {
                "line": { "$ref": "#/$defs/patternString" },
                "except": { "$ref": "#/$defs/patternString" }
              }
            }
          ]
        },
        "strip_suffix": { "$ref": "#/$defs/patternString" },
        "ignore_case": {
          "type": "boolean",
          "description": "Ignore ASCII case only: each letter matches its other case; no other character folds (a long s or a Kelvin sign reads as itself). Only two-rules-footer-below reads it; a composer's other modes refuse the key at load."
        },
        "placeholders": { "$ref": "#/$defs/placeholders" },
        "placeholder_style": { "enum": ["dim"] },
        "footers": { "type": "array", "items": { "$ref": "#/$defs/patternString" }, "minItems": 1 },
        "fold": { "$ref": "#/$defs/patternString" },
        "wrap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["continuation", "kind"],
          "description": "How the composer continues a line onto its next row, declared only where a capture showed the wrap. The box is compared with the typed text under this rule: only the whitespace the row break itself stands for is normalised, the rest of every row must match character for character.",
          "properties": {
            "continuation": { "const": "text-column" },
            "kind": { "enum": ["word", "hard"] }
          }
        },
        "own_rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/patternString" },
          "minItems": 1,
          "description": "Rows the pane draws of its own between the input row and the status row, declared only where a capture shows them. A matching row is not text in the box. Only status-then-one reads the key."
        },
        "frame_rows": {
          "type": "integer",
          "minimum": 0,
          "description": "The empty rows a capture shows the pane drawing under the text, inside the box's frame (the drop before the status line or the closing rule). The box read strips up to this many trailing empty rows as the frame; a row beyond them is one the typed text does not have, and the box is refused. Zero where no capture shows such a row: don't guess."
        },
        "border": {
          "type": "object",
          "additionalProperties": false,
          "required": ["top", "bottom"],
          "description": "The box's own border rows, declared only for a CLI whose captures draw them: `top` the row directly above the input row, `bottom` the row directly below the input rows and directly above the status row, both whole rows at one width (the captures draw them at the pane's width). The bordered frame is read beside the blank one; a frame with only one of the two rows, a row displaced from the input row or the status row, or a border-shaped row inside the box leaves the screen unknown. A composer without this field reads only the blank frame.",
          "properties": {
            "top": { "$ref": "#/$defs/patternString" },
            "bottom": { "$ref": "#/$defs/patternString" }
          }
        },
        "fallback": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["all", "kind"],
            "properties": {
              "all": { "$ref": "#/$defs/patterns" },
              "kind": { "enum": ["idle", "working", "unsent", "permission", "trust", "question", "vendor notice", "provider error", "rate limit", "unknown"] }
            }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "mode": { "const": "box-to-rule" } }, "required": ["mode"] }, "then": { "required": ["rule"] } },
        { "if": { "properties": { "mode": { "const": "status-last" } }, "required": ["mode"] }, "then": { "required": ["status_line"] } },
        { "if": { "properties": { "mode": { "const": "status-then-one" } }, "required": ["mode"] }, "then": { "required": ["status_line", "fallback"] } },
        { "if": { "properties": { "mode": { "const": "two-rules-footer-below" } }, "required": ["mode"] }, "then": { "required": ["rule", "footers"] } },
        { "if": { "required": ["ignore_case"] }, "then": { "properties": { "mode": { "const": "two-rules-footer-below" } } } },
        { "if": { "required": ["status_below"] }, "then": { "properties": { "mode": { "enum": ["status-last", "status-then-one"] } } } },
        { "if": { "required": ["border"] }, "then": { "properties": { "mode": { "enum": ["status-last", "status-then-one"] } } } },
        { "if": { "required": ["own_rows"] }, "then": { "properties": { "mode": { "const": "status-then-one" } } } }
      ]
    }
  }
}
